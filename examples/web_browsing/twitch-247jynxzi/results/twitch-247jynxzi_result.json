      },
      {
        "type": "wait",
        "params": {
          "seconds": 15
        }
      },
      {
        "type": "stop_stats_logging",
        "params": {}
      },
      {
        "type": "terminate",
        "params": {
          "reason": "Watched 247jynxzi live stream and collected Twitch playback stats."
        }
      }
    ],
    "end_state": "Action Completed",
    "executed": []
  }
