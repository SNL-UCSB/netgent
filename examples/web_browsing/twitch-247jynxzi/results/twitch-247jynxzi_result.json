        }
      },
      {
        "type": "wait",
        "params": {
          "seconds": 8
        }
      },
      {
        "type": "terminate",
        "params": {
          "reason": "Navigated to 247jynxzi's Twitch channel."
        }
      }
    ],
    "end_state": "",
    "executed": []
  },
  {
    "name": "Watching 247jynxzi Live Stream",
    "description": "On the 247jynxzi Twitch channel page with the player available.",
    "checks": [
      {
        "type": "element",
        "params": {
          "by": "css selector",
          "selector": "video",
          "check_visibility": false,
          "timeout": 10
        }
      }
    ],
    "actions": [
      {
        "type": "click",
        "params": {
          "by": "css selector",
          "selector": "video"
        }
      },
      {
        "type": "start_stats_logging",
        "params": {
          "out_path": "twitch_247jynxzi_stats.jsonl",
          "interval": 2.0
